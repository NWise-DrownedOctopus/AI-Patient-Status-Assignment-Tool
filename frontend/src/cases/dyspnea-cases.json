[
  {
    "name": "Demo: sat 88% -> inpatient",
    "inputs": { "stable": true, "o2sat": 88 },
    "expect": { "status": "inpatient", "matched": ["o2sat"], "notMet": [] }
  },
  {
    "name": "Demo: sat 94% -> observation",
    "inputs": { "stable": true, "o2sat": 94 },
    "expect": { "status": "observation", "notMet": ["o2sat"] }
  },
  {
    "name": "Boundary: sat 90% is not below 90 -> observation",
    "inputs": { "stable": true, "o2sat": 90 },
    "expect": { "status": "observation", "notMet": ["o2sat"] }
  },
  {
    "name": "Boundary: sat 89% -> inpatient",
    "inputs": { "stable": true, "o2sat": 89 },
    "expect": { "status": "inpatient", "matched": ["o2sat"] }
  },
  {
    "name": "Sat not entered -> needs review",
    "inputs": { "stable": true },
    "expect": { "status": "review", "missing": ["o2sat"] }
  },
  {
    "name": "Nothing entered -> needs review, naming every required field",
    "inputs": {},
    "expect": { "status": "review", "missing": ["stable", "o2sat"] }
  },
  {
    "name": "Stability not answered -> needs review",
    "inputs": { "o2sat": 85 },
    "expect": { "status": "review", "missing": ["stable"] }
  },
  {
    "name": "Unstable patient -> needs review (outside this rule set)",
    "inputs": { "stable": false, "o2sat": 85 },
    "expect": { "status": "review" }
  },
  {
    "name": "BiPAP with normal sat 96% -> inpatient",
    "inputs": { "stable": true, "o2sat": 96, "ventilation": true },
    "expect": { "status": "inpatient", "matched": ["ventilation"] }
  },
  {
    "name": "COPD exacerbation on IV anti-infectives, sat 93% -> inpatient",
    "inputs": { "stable": true, "o2sat": 93, "copd": true, "iv_antiinfective": true },
    "expect": { "status": "inpatient", "matched": ["copd", "iv_antiinfective"], "notMet": ["o2sat"] }
  },
  {
    "name": "COPD exacerbation without IV therapy, sat 93% -> observation",
    "inputs": { "stable": true, "o2sat": 93, "copd": true },
    "expect": { "status": "observation" }
  },
  {
    "name": "IV anti-infectives but no COPD, sat 93% -> observation",
    "inputs": { "stable": true, "o2sat": 93, "iv_antiinfective": true },
    "expect": { "status": "observation" }
  },
  {
    "name": "ABG: PCO2 50 and pH 7.33 -> inpatient",
    "inputs": { "stable": true, "o2sat": 95, "paco2": 50, "ph": 7.33 },
    "expect": { "status": "inpatient", "matched": ["paco2", "ph"] }
  },
  {
    "name": "ABG: PCO2 50 but pH 7.40 -> observation (both must hold)",
    "inputs": { "stable": true, "o2sat": 95, "paco2": 50, "ph": 7.4 },
    "expect": { "status": "observation", "notMet": ["o2sat", "ph"] }
  },
  {
    "name": "Hemoptysis 60 mL -> inpatient",
    "inputs": { "stable": true, "o2sat": 95, "hemoptysis_ml": 60 },
    "expect": { "status": "inpatient", "matched": ["hemoptysis_ml"], "notMet": ["o2sat"] }
  },
  {
    "name": "Hemoptysis exactly 50 mL is not more than 50 -> observation",
    "inputs": { "stable": true, "o2sat": 95, "hemoptysis_ml": 50 },
    "expect": { "status": "observation", "notMet": ["hemoptysis_ml", "o2sat"] }
  },
  {
    "name": "Medicare, sat 88%, 2+ midnights expected -> inpatient",
    "payer": "medicare",
    "medicare": { "midnights": true },
    "inputs": { "stable": true, "o2sat": 88 },
    "expect": { "status": "inpatient", "matched": ["o2sat"] }
  },
  {
    "name": "Medicare, sat 88%, midnights not answered -> needs review",
    "payer": "medicare",
    "inputs": { "stable": true, "o2sat": 88 },
    "expect": { "status": "review", "missing": ["midnights"], "matched": ["o2sat"] }
  },
  {
    "name": "Medicare, sat 88%, fewer than 2 midnights, no exclusion -> needs review",
    "payer": "medicare",
    "medicare": { "midnights": false },
    "inputs": { "stable": true, "o2sat": 88 },
    "expect": { "status": "review", "missing": [] }
  },
  {
    "name": "Medicare, sat 88%, fewer than 2 midnights but left AMA -> inpatient",
    "payer": "medicare",
    "medicare": { "midnights": false, "left_ama": true },
    "inputs": { "stable": true, "o2sat": 88 },
    "expect": { "status": "inpatient" }
  },
  {
    "name": "Medicare, BiPAP with sat 96%, midnights not answered -> inpatient (ventilation exclusion comes from the findings)",
    "payer": "medicare",
    "inputs": { "stable": true, "o2sat": 96, "ventilation": true },
    "expect": { "status": "inpatient", "matched": ["ventilation"] }
  },
  {
    "name": "Other payer, sat 88% -> inpatient with no midnight question",
    "payer": "other",
    "inputs": { "stable": true, "o2sat": 88 },
    "expect": { "status": "inpatient" }
  },
  {
    "name": "Payer not chosen, sat 88% -> needs review, payer needed",
    "payer": null,
    "inputs": { "stable": true, "o2sat": 88 },
    "expect": { "status": "review", "missing": ["payer"] }
  },
  {
    "name": "Medicare, sat 94% -> observation stays observation",
    "payer": "medicare",
    "inputs": { "stable": true, "o2sat": 94 },
    "expect": { "status": "observation" }
  },
  {
    "name": "Payer not chosen, sat 94% -> observation (payer does not matter yet)",
    "payer": null,
    "inputs": { "stable": true, "o2sat": 94 },
    "expect": { "status": "observation" }
  }
]
